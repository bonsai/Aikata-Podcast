# Choose a model provider and set its API key.
# The default model is openai/gpt-5-mini.
OPENAI_API_KEY=
# Optional: change the Mastra model, e.g. anthropic/claude-haiku-4-5
MASTRA_MODEL=openai/gpt-5-mini

# Deepgram speech-to-text (used when transcribing a saved recording)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Local API server
PORT=8787
