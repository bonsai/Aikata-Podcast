# Cloudflare Workers AI — the LLM provider for Aikata Podcast.
# Create a Cloudflare API token with Workers AI permissions and copy your Account ID.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional Workers AI model. Default: @cf/google/gemma-4-26b-a4b-it
WORKERS_AI_MODEL=@cf/google/gemma-4-26b-a4b-it

# Deepgram speech-to-text (used when transcribing a saved recording)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Local API server
PORT=8787
